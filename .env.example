# ===== HTTP =====
PORT=3334

# Protege /qr (e identifica o serviço). Mesmo valor usado no ml-ofertas-service.
API_KEY=

# ===== Canal do WhatsApp (OBRIGATÓRIO) =====
# Código de convite = parte após whatsapp.com/channel/
# Sem isto o serviço não sobe (falha no boot com mensagem clara).
CHANNEL_INVITE_CODE=

# ===== Destino dos cupons =====
# URL do ml-ofertas-service (rede interna do Easypanel de preferência). Sem barra final.
ML_OFERTAS_URL=http://ml-ofertas:3333

# De quantos em quantos minutos reler o canal (mecanismo primário).
POLL_MINUTES=15

# (Opcional) Webhook para alertas de desconexão / silêncio do canal.
ALERT_WEBHOOK_URL=

# ===== Telegram (redundância, opcional) =====
# Conta DEDICADA que já está no canal. Credenciais em https://my.telegram.org.
TG_API_ID=32503909
TG_API_HASH=acd5c42b8353a9750e4a6b2f569e87f0
# Gerada UMA vez com: node scripts/tg-login.js  (trate como senha)
TG_SESSION=
# '+hash' do convite privado (parte após t.me/+), ou '@username' se o canal for público
TG_CHANNEL=

# ===== Diversos =====
LOG_LEVEL=info
# Em produção (Docker) estes já apontam para os volumes /app/auth_state e /app/data.
# AUTH_DIR=./auth_state
# DATA_DIR=./data
