# ===== HTTP =====
PORT=3334

# Protege /qr (e identifica o serviço). Mesmo valor usado no ml-ofertas-service.
API_KEY=

# ===== Canal do WhatsApp =====
# Código de convite = parte após whatsapp.com/channel/
CHANNEL_INVITE_CODE=0029VaXBWV24IBhJJ0T1023C

# ===== Destino dos cupons =====
# URL do ml-ofertas-service (rede interna do Easypanel de preferência). Sem barra final.
ML_OFERTAS_URL=http://ml-ofertas:3333

# De quantos em quantos minutos reler o canal (mecanismo primário).
POLL_MINUTES=15

# (Opcional) Webhook para alertas de desconexão / silêncio do canal.
ALERT_WEBHOOK_URL=

# ===== Diversos =====
LOG_LEVEL=info
# Em produção (Docker) estes já apontam para os volumes /app/auth_state e /app/data.
# AUTH_DIR=./auth_state
# DATA_DIR=./data
